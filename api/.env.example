# --- the identity provider this API trusts ---
# Must equal the IdP's IDP_ISSUER exactly: it is checked against the `iss` of every access token.
IDP_ISSUER=http://localhost:9001
# This API's own audience, as registered on the IdP (`local-idp register-api --audience ...`). Tokens issued for any other
# API (a different `aud`) are rejected.
IDP_AUDIENCE=todo-api
# Where the IdP publishes its public signing keys. Leave empty to use <IDP_ISSUER>/jwks.json.
IDP_JWKS_URL=
# How long fetched keys are cached before asking the IdP again (a token signed by an unknown key forces a refetch).
IDP_JWKS_CACHE_SECONDS=300
# Seconds of clock difference tolerated when checking exp / iat.
IDP_CLOCK_SKEW_SECONDS=10

# --- scopes this API requires (register them on the IdP app: --scope todos:read --scope todos:write) ---
API_READ_SCOPE=todos:read
API_WRITE_SCOPE=todos:write

# --- the browser UI (served by this API at /): signs people in with the IdP, then lists their todos ---
# Register it on the IdP as a public app: see the README. Its redirect URI must match the one registered there exactly.
UI_CLIENT_ID=todo-ui
UI_REDIRECT_URI=http://localhost:5174/auth/callback
UI_SCOPES=openid profile email todos:read todos:write
# true when the API is served over https (marks the session cookie Secure)
UI_COOKIE_SECURE=false
