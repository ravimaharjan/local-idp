# --- the identity provider's own database ---
IDP_DB_HOST=localhost
IDP_DB_PORT=5435
IDP_DB_USER=idp-user
IDP_DB_PASSWORD=idp-pass-123
IDP_DB_NAME=idp_db

# --- tokens ---
# The `iss` of every token, and the base of the discovery document. The API's IDP_ISSUER must equal this exactly.
IDP_ISSUER=http://localhost:9001
# The audience used when a client does not ask for one. Each API has its own audience, registered with
# `local-idp register-api --audience <name>`; clients pick it with the `audience` parameter. An API's IDP_AUDIENCE must equal its own.
IDP_API_AUDIENCE=todo-api
# Folder holding the signing keys (<kid>.pem), made by `local-idp generate-key`. Never commit it.
IDP_KEYS_DIR=keys
IDP_ACCESS_TOKEN_MINUTES=10
IDP_REFRESH_TOKEN_HOURS=12
# How long an authorization code can be exchanged for tokens.
IDP_CODE_SECONDS=60

# --- password sign-in ---
IDP_MAX_FAILED_LOGINS=5
IDP_LOCK_MINUTES=30

# Browser origins allowed to call /token, /userinfo, /revoke (comma separated): the web app.
IDP_CORS_ORIGINS=http://localhost:5174
